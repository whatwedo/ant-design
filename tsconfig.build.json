{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false
  },
  "include": ["components/**/*"],
  "exclude": [
    "node_modules",
    "lib",
    "es",
    "components/**/__tests__/**",
    "components/**/demo/**",
    "components/**/*.test.tsx",
    "components/**/*.test.ts"
  ]
}
