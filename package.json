  "scripts": {
    "postinstall": "node scripts/patch-rc-util.js",
    "build": "node scripts/build.js",
    "clean": "rimraf es lib dist coverage report.html",
    "start": "cross-env NODE_ENV=development concurrently \"bisheng start -c ./site/bisheng.config.js\"",
    "test": "jest --config .jest.js --cache=false",
    "test:update": "jest --config .jest.js --cache=false -u",
    "test-node": "jest --config .jest.node.js --cache=false",
    "tsc": "tsc --noEmit",
    "site:test": "jest --config .jest.site.js --cache=false --force-exit",
    "test-image": "jest --config .jest.image.js --no-cache -i -u",
    "lint": "npm run tsc && npm run lint:script && npm run lint:demo && npm run lint:style",
    "lint:script": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:demo": "eslint components/*/demo/*.md",
    "lint:style": "stylelint '{site,components}/**/*.less'",
    "lint-fix": "npm run lint:script -- --fix && npm run lint:demo -- --fix && npm run lint:style -- --fix",
    "version": "node ./scripts/generate-version"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "IE 11",
    "not IE 10"
